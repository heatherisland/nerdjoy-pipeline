# Secrets - never commit
# Anything .env*, so .env.local and .env.production are covered too, with the
# committed template negated back in.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
# Service-account and other credential JSON, under whatever name it is saved.
*-service-account*.json
service_account.json
sa.json
credentials.json
client_secret*.json
gcp-*.json
# dbt stores warehouse credentials here by convention.
profiles.yml
dbt/profiles.yml
# Cloud CLI state.
.gcloud/
.aws/

# Personal data - never commit
resumes/
outreach/
contacts/
*.csv
!tests/fixtures/sample_tracker.csv
!dbt/seeds/applications_seed.csv

# Generated artifacts
metrics.json
dashboard/dist/
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.coverage

# macOS / editors
.DS_Store
.idea/
*.swp
*.egg-info/
