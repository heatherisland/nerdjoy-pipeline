# Secrets - never commit
# Anything .env*, so .env.local and .env.production are covered too, with the
# committed template negated back in.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
# Service-account and other credential JSON, under whatever name it is saved.
*-service-account*.json
service_account.json
sa.json
credentials.json
client_secret*.json
gcp-*.json
# dbt stores warehouse credentials here by convention.
profiles.yml
dbt/profiles.yml
# Cloud CLI state.
.gcloud/
.aws/

# Personal data - never commit
resumes/
outreach/
contacts/
*.csv
!tests/fixtures/sample_tracker.csv
# dbt/seeds/applications_seed.csv is generated from the real tracker and holds
# real company names. It is NEVER committed. CI uses the fictional fixture below.
!dbt/seeds/sample_seed.csv

# Generated artifacts
metrics.json
dashboard/dist/
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.coverage

# macOS / editors
.DS_Store
.idea/
*.swp
*.egg-info/

# Real agency names. Only the fictional example is committed.
config/agency_channels.txt

# Proof screenshots: these show real company names. Local only.
docs/proof/
config/excluded_companies.txt

# Internal build scaffolding: holds real project ids, local paths and
# decision history. Kept on disk, never published.
docs/superpowers/

# Scratch output for local scripts, e.g. email_reconcile's review CSV. Never
# committed: it can hold real company names pulled from an inbox.
.local/

# Env-driven profile baked into the Airflow image; holds no secrets.
!dbt/airflow/profiles.yml

# Drafts of outgoing posts, local only (see docs/PROJECT_STATUS.md)
content/
