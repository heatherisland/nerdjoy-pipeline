# Copy to .env and fill in. .env is gitignored; never commit real values.

# Supabase or Neon Postgres. Must be cloud reachable: Fivetran is hosted and
# cannot connect to localhost.
PGHOST=db.<project-ref>.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# BigQuery. Billing must be enabled: the sandbox rejects Fivetran.
# Path to the service account JSON, kept outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BIGQUERY_PROJECT=
BIGQUERY_DATASET=nerdjoy_pipeline

# HubSpot private app token. Scopes: crm.objects.companies.read/write,
# crm.objects.contacts.read/write
HUBSPOT_TOKEN=

# Google Sheet used as the second Hightouch destination.
GSHEET_URL=
GSHEET_ID=

# GitHub
GITHUB_REPO=
